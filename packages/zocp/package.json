{
  "name": "@takazudo/zudo-ogp-check-panel",
  "version": "0.1.0",
  "description": "OGP check panel — framework-agnostic utility for inspecting OGP meta tags.",
  "private": false,
  "license": "MIT",
  "type": "module",
  "author": "Takeshi Takatsudo <takazudo@gmail.com> (https://github.com/Takazudo)",
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Takazudo/zudo-ogp-check-panel.git",
    "directory": "packages/zocp"
  },
  "homepage": "https://github.com/Takazudo/zudo-ogp-check-panel",
  "bugs": {
    "url": "https://github.com/Takazudo/zudo-ogp-check-panel/issues"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "prepublishOnly": "pnpm build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^22.0.0",
    "jsdom": "^25.0.0",
    "typescript": "^5.6.0",
    "vite": "^7.3.2",
    "vitest": "^4.1.4"
  }
}
